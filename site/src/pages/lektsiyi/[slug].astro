---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { filterVisible, showDrafts } from '../../lib/visibility';
import { topicById } from '../../lib/topics';

export async function getStaticPaths() {
  const all = await getCollection('lectures');
  const visible = filterVisible(all, { prod: import.meta.env.PROD, showDrafts: showDrafts() });
  return visible.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const topicId = entry.id.slice(0, 2);
const topic = topicById(topicId);
const quizzes = await getCollection('quizzes', (q) => q.data.topic === topicId);
const toc = headings.filter((h) => h.depth === 2);
const fmt = new Intl.DateTimeFormat('uk-UA', { dateStyle: 'long' });
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="lecture" style={`--accent: ${topic?.color ?? 'var(--primary)'}`}>
    <header class="lecture-head">
      {entry.data.status !== 'published' && <p class="draft-badge">Чернетка, не опубліковано</p>}
      {topic && <p class="topic-label">Тема {topic.order} · Модуль {topic.module}</p>}
      <h1>{entry.data.title}</h1>
      <p class="meta">{toc.length} розділів · Оновлено {fmt.format(entry.data.updatedAt)}</p>
    </header>
    <div class="lecture-grid">
      {toc.length > 0 && (
        <nav class="toc" aria-label="Зміст">
          <strong>Зміст</strong>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-target={h.slug}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose lecture-body"><Content /></div>
    </div>
    {entry.data.sources.length > 0 && (
      <section class="sources">
        <h2>Джерела</h2>
        <ul>{entry.data.sources.map((s) => <li>{s}</li>)}</ul>
      </section>
    )}
    {quizzes.length > 0 && (
      <section class="quiz-cta">
        <div>
          <h2>Перевір себе</h2>
          <p>Питання за матеріалом лекції, двома рівнями складності.</p>
        </div>
        <div class="cta-links">
          {quizzes.map((q) => (
            <a class="btn" href={`/tests/${topicId}/${q.data.level}/`}>
              {q.data.level === 'nurse' ? 'Тест: медсестра' : 'Тест: лікар'}
            </a>
          ))}
        </div>
      </section>
    )}
    <div id="lecture-end" data-slug={entry.id}></div>
  </article>
  <script>
    const el = document.getElementById('lecture-end');
    const slug = el?.dataset.slug;
    if (el && slug) {
      new IntersectionObserver((entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) {
          try { localStorage.setItem(`aiti:read:${slug}`, '1'); } catch {}
          obs.disconnect();
        }
      }).observe(el);
    }

    // TOC scroll-spy: highlight the section currently in view.
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-target]')]
        .map((a) => [a.dataset.target!, a]),
    );
    if (links.size > 0) {
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            e.target.classList.toggle('in-view', e.isIntersecting);
            const id = e.target.querySelector('h2')?.id;
            const link = id && links.get(id);
            if (link) link.classList.toggle('active', e.isIntersecting);
          }
        },
        { rootMargin: '-20% 0px -60% 0px' },
      );
      document.querySelectorAll('.lecture-section').forEach((s) => spy.observe(s));
    }
  </script>
  <style>
    .lecture-head { padding-block: 2rem 1rem; max-width: 52rem; }
    .topic-label {
      color: var(--accent);
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.4rem;
    }
    .lecture-head h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin: 0 0 0.5rem; }
    .draft-badge {
      display: inline-block;
      background: color-mix(in srgb, var(--warn) 15%, transparent);
      color: var(--warn);
      border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
      border-radius: 999px;
      padding: 0.15rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 700;
    }
    .meta { color: var(--text-muted); font-size: 0.9rem; margin: 0; }

    .lecture-grid { display: grid; gap: 2rem; counter-reset: section; }
    /* Grid items must be allowed to shrink below content min-width. */
    .lecture-grid > * { min-width: 0; }

    /* Timeline rail: base line + gradient beam that grows with scroll where supported. */
    .lecture-body { position: relative; padding-left: 3.4rem; max-width: 49.4rem; }
    .lecture-body::before {
      content: '';
      position: absolute;
      left: 1.1rem;
      top: 1.5rem;
      bottom: 1.5rem;
      width: 2px;
      background: var(--border);
      border-radius: 1px;
    }
    .lecture-body::after {
      content: '';
      position: absolute;
      left: 1.1rem;
      top: 1.5rem;
      bottom: 1.5rem;
      width: 2px;
      border-radius: 1px;
      background: linear-gradient(180deg, var(--accent), #c084fc 60%, transparent);
      transform-origin: top;
    }
    @supports (animation-timeline: view()) {
      .lecture-body::after {
        animation: lecture-beam linear both;
        animation-timeline: view();
        animation-range: cover 8% cover 80%;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .lecture-body::after { animation: none; transform: none; }
    }
    @keyframes lecture-beam {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }

    /* Section cards produced by rehype-sections, hung on the rail. */
    .lecture-body :global(.lecture-section) {
      counter-increment: section;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
      padding: 2rem 2.25rem 1.75rem;
      margin-block: 2.25rem;
      position: relative;
      line-height: 1.75;
    }
    .lecture-body :global(.lecture-section:first-child) { margin-top: 0; }
    /* Numbered dot centered on the rail. */
    .lecture-body :global(.lecture-section::before) {
      content: counter(section, decimal-leading-zero);
      position: absolute;
      left: -3.42rem;
      top: 1.1rem;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 2.3rem;
      height: 2.3rem;
      border-radius: 999px;
      background: var(--bg);
      border: 1.5px solid color-mix(in srgb, var(--accent) 50%, var(--border));
      color: var(--accent);
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 0.85rem;
      font-variant-numeric: tabular-nums;
      transition: box-shadow 0.25s ease, background 0.25s ease;
    }
    .lecture-body :global(.lecture-section.in-view::before) {
      background: color-mix(in srgb, var(--accent) 18%, var(--bg));
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 16%, transparent);
    }
    .lecture-body :global(.lecture-section > h2) {
      margin: 0 0 1.35rem;
      font-size: 1.45rem;
      scroll-margin-top: 5rem;
    }
    .lecture-body :global(.lecture-section > h3) { margin-top: 1.75rem; }
    .lecture-body :global(.lecture-section > h3) { font-size: 1.1rem; }
    .lecture-body :global(.lecture-section > :last-child) { margin-bottom: 0; }
    @media (max-width: 640px) {
      .lecture-body { padding-left: 2.7rem; }
      .lecture-body::before, .lecture-body::after { left: 0.85rem; }
      .lecture-body :global(.lecture-section::before) {
        left: -2.72rem;
        width: 1.85rem;
        height: 1.85rem;
        font-size: 0.7rem;
      }
      .lecture-body :global(.lecture-section) { padding: 1.4rem 1.15rem 1.15rem; }
    }

    .toc { font-size: 0.9rem; }
    .toc strong {
      font-family: var(--font-heading);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .toc ol { list-style: none; padding: 0; margin: 0.6rem 0 0; counter-reset: toc; }
    .toc li { counter-increment: toc; }
    .toc a {
      display: flex;
      gap: 0.55rem;
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.3rem 0.6rem;
      border-radius: var(--radius-sm);
      border-left: 2px solid transparent;
      transition: color 0.15s ease, background 0.15s ease;
    }
    .toc a::before {
      content: counter(toc, decimal-leading-zero);
      color: color-mix(in srgb, var(--accent) 65%, transparent);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .toc a:hover { color: var(--text); background: var(--glass); }
    .toc a.active { color: var(--text); border-left-color: var(--accent); background: var(--glass); }

    .sources {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      padding: 1.25rem 1.5rem;
      margin-block: 1.5rem;
      max-width: 46rem;
    }
    .sources h2 { font-size: 1.1rem; margin-top: 0; }
    .sources ul { margin: 0; padding-left: 1.25rem; color: var(--text-muted); font-size: 0.9rem; }

    .quiz-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background:
        radial-gradient(24rem 12rem at 90% 0%, var(--glow-1), transparent 65%),
        var(--surface);
      padding: 1.5rem;
      margin-block: 1.5rem;
      max-width: 46rem;
    }
    .quiz-cta h2 { margin: 0 0 0.25rem; font-size: 1.25rem; }
    .quiz-cta p { margin: 0; color: var(--text-muted); font-size: 0.9rem; }
    .cta-links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .quiz-cta .btn { background: var(--accent); }

    @media (min-width: 60rem) {
      .lecture-grid { grid-template-columns: 15rem minmax(0, 1fr); align-items: start; }
      .toc { position: sticky; top: 4.5rem; }
    }
  </style>
</Base>
