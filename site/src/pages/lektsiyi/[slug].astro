---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { filterVisible, showDrafts } from '../../lib/visibility';
import { topicById } from '../../lib/topics';
import PixelEcg from '../../components/PixelEcg.astro';

export async function getStaticPaths() {
  const all = await getCollection('lectures');
  const visible = filterVisible(all, { prod: import.meta.env.PROD, showDrafts: showDrafts() });
  return visible.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const topicId = entry.id.slice(0, 2);
const topic = topicById(topicId);
// Title-slide motif comes from the topic registry so each lecture opens differently.
const icons = topic?.icons ?? ['kit', 'heart', 'hp'];
// Nurse level first — it is the primary audience of the course.
const quizzes = (await getCollection('quizzes', (q) => q.data.topic === topicId))
  .sort((a, b) => (a.data.level === 'nurse' ? -1 : 1));
const toc = headings.filter((h) => h.depth === 2);
// Title slide + one slide per h2 + final slide.
const total = toc.length + 2;
const romanModule = entry.data.module === 1 ? 'I' : 'II';
const updated = entry.data.updatedAt.toLocaleDateString('uk-UA', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});
const hudTitle = `ЛЕКЦІЯ ${topicId} · ${(topic?.short ?? entry.data.title).toUpperCase()}`;
---
<Base title={entry.data.title} description={entry.data.description} variant="presentation">
  <header class="hud">
    <a class="hud-back" href="/"><span class="g">←</span> АІТ·ЛЕКЦІЇ</a>
    <span class="hud-title">{hudTitle}</span>
    <span class="hud-right">
      <button class="hud-menu" id="slide-menu-btn" aria-expanded="false" aria-controls="slide-menu" aria-label="Список слайдів">☰</button>
      <span class="beat hud-heart g" aria-hidden="true">♥</span>
      <span class="bar hud-bar" role="progressbar" aria-label="Прогрес лекції" aria-valuemin="1" aria-valuemax={total} aria-valuenow="1" id="hud-bar">
        <span id="hud-fill" style={`width:${Math.round((1 / total) * 100)}%`}></span>
      </span>
      <span class="hud-count"><span id="hud-cur">1</span>/{total}</span>
    </span>
  </header>

  <nav class="slide-menu" id="slide-menu" hidden aria-label="Слайди лекції">
    <ol>
      <li><button data-goto="1">Титул</button></li>
      {toc.map((h, i) => <li><button data-goto={i + 2}>{h.text}</button></li>)}
      <li><button data-goto={total}>Фінал · тест</button></li>
    </ol>
  </nav>

  <div class="slides prose" data-slug={entry.id} data-total={total}>
    <section class="slide title-slide">
      {entry.data.status !== 'published' && <p class="draft-badge">!! ЧЕРНЕТКА — НЕ ОПУБЛІКОВАНО</p>}
      <p class="title-kicker"><span class="g">★</span> МОДУЛЬ {romanModule} · ТЕМА {topicId} · ОНОВЛЕНО {updated} <span class="g">★</span></p>
      <p class="title-icons" aria-hidden="true">
        {icons.map((icon, i) => (
          icon === 'heart' ? <span class="pixel-heart beat"><span></span></span>
          : icon === 'ecg' ? <span class="ecg-slot"><PixelEcg /></span>
          : <img class:list={['px', i % 2 ? 'bob-rev' : 'bob']} src={`/icons/icon-${icon}.png`} alt="" height="56" />
        ))}
      </p>
      <h1>{entry.data.title.toUpperCase()}</h1>
      <p class="title-lead">{entry.data.description}</p>
      <p class="title-foot">
        {total} СЛАЙДІВ · ДЖЕРЕЛА НА ФІНАЛЬНОМУ СЛАЙДІ<br /><br />
        <span class="blink"><span class="g">▼</span> [SPACE] — ДАЛІ</span>
      </p>
    </section>

    <Content />

    <section class="slide final-slide">
      <p class="final-kicker bob"><span class="g">★</span> РІВЕНЬ ПРОЙДЕНО · ПРОГРЕС 100% <span class="g">★</span></p>
      <h2 class="final-title">{quizzes.length > 0 ? 'BOSS FIGHT: ТЕСТ' : 'РІВЕНЬ ПРОЙДЕНО'}</h2>
      {quizzes.length > 0 && (
        <div class="final-actions">
          {quizzes.map((q, i) => (
            <a class:list={['btn', { ghost: i > 0 }]} href={`/tests/${topicId}/${q.data.level}/`}>
              {i === 0 && <span class="g">▶</span>}
              {q.data.level === 'nurse' ? 'ТЕСТ: МЕДСЕСТРИ' : 'ТЕСТ: ЛІКАРІ'}
            </a>
          ))}
        </div>
      )}
      {entry.data.sources.length > 0 && (
        <div class="final-sources panel">
          <p class="kicker">ДЖЕРЕЛА</p>
          <ul>{entry.data.sources.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
      <p class="final-back"><a href="/"><span class="g">←</span> ДО ВСІХ ЛЕКЦІЙ</a></p>
    </section>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>('.slides');
    const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
    const fill = document.getElementById('hud-fill');
    const bar = document.getElementById('hud-bar');
    const curEl = document.getElementById('hud-cur');
    const menu = document.getElementById('slide-menu');
    const menuBtn = document.getElementById('slide-menu-btn');
    const slug = root?.dataset.slug;
    const total = slides.length;
    let cur = 1;

    const hudHeight = () =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hud-h')) || 52;

    function store(n: number) {
      if (!slug) return;
      try {
        const prev = Number(localStorage.getItem(`aiti:progress:${slug}`) ?? 0);
        if (n > prev) localStorage.setItem(`aiti:progress:${slug}`, String(n));
        if (n >= total) localStorage.setItem(`aiti:read:${slug}`, '1');
      } catch {
        // storage unavailable — progress tracking is non-critical
      }
    }

    function setCurrent(n: number) {
      cur = n;
      if (curEl) curEl.textContent = String(n);
      if (fill) fill.style.width = `${Math.round((n / total) * 100)}%`;
      bar?.setAttribute('aria-valuenow', String(n));
      store(n);
    }

    if (slides.length > 0) {
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) setCurrent(slides.indexOf(e.target as HTMLElement) + 1);
          }
        },
        { threshold: 0.55 },
      );
      slides.forEach((s) => spy.observe(s));

      // Tall sections never reach 55% visibility; fall back to whichever slide owns the top edge.
      const edge = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && (e.target as HTMLElement).offsetHeight > innerHeight) {
              setCurrent(slides.indexOf(e.target as HTMLElement) + 1);
            }
          }
        },
        { rootMargin: `-${hudHeight()}px 0px -85% 0px` },
      );
      slides.forEach((s) => edge.observe(s));
    }

    function goTo(n: number) {
      const target = slides[Math.min(total, Math.max(1, n)) - 1];
      if (!target) return;
      scrollTo({ top: target.offsetTop - hudHeight(), behavior: 'smooth' });
    }

    function closeMenu() {
      if (!menu) return;
      menu.hidden = true;
      menuBtn?.setAttribute('aria-expanded', 'false');
    }

    menuBtn?.addEventListener('click', () => {
      if (!menu) return;
      menu.hidden = !menu.hidden;
      menuBtn.setAttribute('aria-expanded', String(!menu.hidden));
    });
    menu?.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => {
      b.addEventListener('click', () => {
        goTo(Number(b.dataset.goto));
        closeMenu();
      });
    });

    addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      if (document.querySelector('dialog[open]')) return;
      const t = e.target as HTMLElement | null;
      // Never hijack keys typed into a field or aimed at a control.
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT|BUTTON|A|SUMMARY)$/.test(t.tagName))) return;
      if (e.key === 'Escape') { closeMenu(); return; }
      if (e.key === ' ' || e.key === 'ArrowDown' || e.key === 'PageDown') {
        e.preventDefault();
        goTo(cur + 1);
      }
      if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault();
        goTo(cur - 1);
      }
    });
  </script>

  <style>
    /* ---------- HUD ---------- */
    .hud {
      position: sticky;
      top: 0;
      z-index: 9;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      height: var(--hud-h);
      padding: 0 1.5rem;
      background: var(--surface-2);
      border-bottom: var(--bw) solid var(--ink);
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.6;
    }
    .hud-back { color: var(--muted); text-decoration: none; white-space: nowrap; }
    .hud-back:hover { color: var(--accent); }
    .hud-title {
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .hud-right { display: flex; align-items: center; gap: 0.625rem; white-space: nowrap; }
    .hud-heart { color: var(--danger); font-size: 0.875rem; line-height: 1; }
    .hud-bar { width: 160px; }
    .hud-count { color: var(--accent); font-variant-numeric: tabular-nums; }
    .hud-menu {
      font-family: var(--font-body);
      font-size: 1.125rem;
      line-height: 1;
      color: var(--muted);
      background: transparent;
      border: var(--bw-sm) solid transparent;
      padding: 0.25rem 0.5rem;
      cursor: pointer;
    }
    .hud-menu:hover, .hud-menu[aria-expanded='true'] { color: var(--accent); border-color: var(--accent); }

    .slide-menu {
      position: fixed;
      top: var(--hud-h);
      right: 1.5rem;
      z-index: 10;
      width: min(24rem, calc(100vw - 3rem));
      max-height: calc(100vh - var(--hud-h) - 2rem);
      overflow-y: auto;
      background: var(--surface);
      border: var(--bw) solid var(--ink);
      box-shadow: var(--shadow-hard-lg);
    }
    .slide-menu ol { list-style: none; margin: 0; padding: 0; counter-reset: menu; }
    .slide-menu li { counter-increment: menu; border-bottom: 2px solid var(--ink); }
    .slide-menu li:last-child { border-bottom: 0; }
    .slide-menu button {
      display: flex;
      gap: 0.75rem;
      width: 100%;
      text-align: left;
      background: transparent;
      border: 0;
      color: var(--text-soft);
      font: inherit;
      font-size: 0.9375rem;
      padding: 0.75rem 1rem;
      cursor: pointer;
    }
    .slide-menu button::before {
      content: counter(menu, decimal-leading-zero);
      font-family: var(--font-display);
      font-size: 10px;
      color: var(--ok);
      flex-shrink: 0;
      padding-top: 0.25rem;
    }
    .slide-menu button:hover { background: var(--surface-3); color: var(--accent); }

    /* ---------- Slide frame ---------- */
    .slides { counter-reset: stage; max-width: none; }
    .slides :global(.slide) {
      min-height: calc(100vh - var(--hud-h));
      scroll-snap-align: start;
      display: grid;
      align-content: center;
      justify-content: center;
      /* minmax(0, …) keeps wide children (tables, figures) from blowing out mobile. */
      grid-template-columns: minmax(0, 1000px);
      padding: 3.5rem 2.25rem;
    }

    /* ---------- Title slide ---------- */
    .title-slide { text-align: center; }
    .draft-badge {
      justify-self: center;
      margin: 0 0 1.5rem;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.6;
      color: var(--danger-text);
      background: var(--danger-bg);
      border: var(--bw-sm) solid var(--danger);
      padding: 0.6rem 1rem;
    }
    .title-kicker {
      margin: 0 0 2rem;
      font-family: var(--font-display);
      font-size: 12px;
      line-height: 1.9;
      color: var(--ok);
    }
    .title-icons {
      margin: 0 0 1.25rem;
      display: flex;
      gap: 1.75rem;
      justify-content: center;
      align-items: center;
    }
    .title-icons img { height: 56px; width: auto; }
    /* The trace is wider than a sprite; the slot keeps the row visually balanced. */
    .ecg-slot { display: inline-flex; align-items: center; }
    .title-slide h1 {
      margin: 0 auto 1.5rem;
      font-size: clamp(22px, 3.8vw, 40px);
      line-height: 1.5;
      color: var(--text);
      text-shadow: 4px 4px 0 var(--title-shadow);
      max-width: 22ch;
    }
    .title-lead {
      margin: 0 auto 1.875rem;
      font-size: 1.125rem;
      line-height: 1.65;
      max-width: 54ch;
      color: var(--text-soft);
    }
    .title-foot {
      margin: 0;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 2.2;
      color: var(--muted);
    }

    /* ---------- Content slides ---------- */
    .slides :global(.lecture-section) { counter-increment: stage; }
    .slides :global(.lecture-section::before) {
      content: 'СТАДІЯ ' counter(stage, decimal-leading-zero);
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.8;
      color: var(--ok);
      margin-bottom: 1.375rem;
    }
    .slides :global(.lecture-section > h2) {
      margin: 0 0 2rem;
      font-size: clamp(17px, 2.6vw, 24px);
      line-height: 1.6;
      color: var(--accent);
      text-shadow: 3px 3px 0 var(--ink);
      scroll-margin-top: var(--hud-h);
    }
    /* Subsections inside a long slide get a header bar so the slide reads as distinct
       blocks instead of one continuous column of prose. */
    .slides :global(.lecture-section > h3) {
      /* Asymmetric margins: the bar binds to the block it introduces, the big gap above
         is what separates it from the previous one. Slides are grid containers, so these
         margins never collapse with the preceding element's — the gap is the sum. */
      margin: 4rem 0 1.25rem;
      padding: 0.875rem 1.25rem;
      background: var(--surface-2);
      border: var(--bw) solid var(--ink);
      border-left-width: 12px;
      border-left-color: var(--accent);
      box-shadow: var(--shadow-hard);
      color: var(--accent);
      font-size: 1.05rem;
      line-height: 1.45;
      text-transform: uppercase;
    }
    /* Only drop the gap when the bar sits directly under the slide title — `:first-of-type`
       would also flatten the first subsection of a long slide, which needs the space most. */
    .slides :global(.lecture-section > h2 + h3) { margin-top: 0; }

    /* Top-level numbered lists are the design's "stage cards": a numbered grid of hard
       panels. Nested lists and lists inside callouts keep plain markdown bullets. */
    .slides :global(.lecture-section > ol) {
      list-style: none;
      padding: 0;
      margin-block: 1.5rem;
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      counter-reset: step;
    }
    .slides :global(.lecture-section > ol > li) {
      counter-increment: step;
      position: relative;
      margin: 0;
      /* Absolute number keeps the card layout intact whatever the item contains. */
      padding: 1.25rem 1.5rem 1.25rem 3.75rem;
      background: var(--surface);
      border: var(--bw) solid var(--ink);
      box-shadow: var(--shadow-hard);
      color: var(--text-soft);
      font-size: 1rem;
      line-height: 1.55;
    }
    .slides :global(.lecture-section > ol > li::before) {
      content: counter(step);
      position: absolute;
      left: 1.5rem;
      top: 1.4rem;
      font-family: var(--font-display);
      font-size: 11px;
      color: var(--ok);
    }
    .slides :global(.lecture-section > ol > li:hover),
    .slides :global(.lecture-section > ol > li:focus-within) {
      /* The press-in transform makes the card a stacking context, which traps a glossary
         balloon opened inside it — later sibling cards would paint over it however high
         its own z-index. Raising the whole card lets the balloon escape. */
      z-index: 2;
    }
    .slides :global(.lecture-section > ol > li:hover) {
      transform: translate(3px, 3px);
      box-shadow: 1px 1px 0 var(--ink);
      border-color: var(--accent);
    }
    .slides :global(.lecture-section > ol > li > strong:first-child),
    .slides :global(.lecture-section > ol > li > span:first-child strong) { color: var(--text); }

    /* ---------- Final slide ---------- */
    .final-slide { text-align: center; }
    .final-kicker {
      margin: 0 0 2rem;
      font-family: var(--font-display);
      font-size: 12px;
      line-height: 1.9;
      color: var(--ok);
    }
    .final-title {
      margin: 0 0 1.875rem;
      font-size: clamp(20px, 3.2vw, 34px);
      line-height: 1.5;
      color: var(--text);
      text-shadow: 4px 4px 0 var(--title-shadow);
    }
    .final-actions {
      display: flex;
      gap: 1.125rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2.25rem;
    }
    .final-sources {
      text-align: left;
      padding: 1.5rem 1.625rem;
      margin-bottom: 1.5rem;
    }
    .final-sources .kicker { margin-bottom: 1rem; }
    .final-sources ul { margin: 0; padding-left: 1.4rem; }
    .final-sources li { color: var(--muted); font-size: 0.9375rem; line-height: 1.6; margin-block: 0.5rem; }
    .final-back { margin: 0; font-family: var(--font-display); font-size: 9px; line-height: 2.4; }
    .final-back a { color: var(--muted); text-decoration: none; }
    .final-back a:hover { color: var(--accent); }

    @media (max-width: 48rem) {
      .hud { padding: 0 0.875rem; gap: 0.5rem; }
      .hud-title { display: none; }
      .hud-bar { width: 80px; }
      .slide-menu { right: 0.5rem; left: 0.5rem; width: auto; }
      .slides :global(.slide) { padding: 2.5rem 1.25rem; }
      .title-icons img { height: 44px; }
    }
  </style>
</Base>
