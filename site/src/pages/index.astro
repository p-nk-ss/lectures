---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { TOPICS } from '../lib/topics';
import { filterVisible, showDrafts } from '../lib/visibility';

const all = await getCollection('lectures');
const visible = filterVisible(all, { prod: import.meta.env.PROD, showDrafts: showDrafts() })
  .filter((l) => l.data.order <= 8);
const bySlugPrefix = new Map(visible.map((l) => [l.id.slice(0, 2), l]));
// Slide count = title slide + one per h2 + final slide, matching the lecture page.
const slideCount = (body: string | undefined) => (body?.match(/^## /gm)?.length ?? 0) + 2;
const first = [...visible].sort((a, b) => a.data.order - b.data.order)[0];
const modules = [
  { n: 1, title: 'МОДУЛЬ I · ПОНЯТТЯ ПРО АНЕСТЕЗІОЛОГІЮ ТА РЕАНІМАТОЛОГІЮ' },
  { n: 2, title: 'МОДУЛЬ II · ШОКОВІ, КОМАТОЗНІ СТАНИ ТА ГОСТРІ ОТРУЄННЯ' },
];
---
<Base title="Анестезіологія та інтенсивна терапія — лекції">
  <section class="hero">
    <h1>АНЕСТЕЗІОЛОГІЯ ТА ІНТЕНСИВНА ТЕРАПІЯ</h1>
    <p class="hero-lead">
      Лекції за протоколами ERC, AHA та МОЗ України. Пройди слайди в режимі презентації,
      склади тест для самоконтролю.
    </p>
    <div class="hero-actions">
      {first && (
        <a class="btn" id="hero-start" href={`/lektsiyi/${first.id}/`}>
          <span class="g">▶</span> <span id="hero-start-label">PRESS START</span>
        </a>
      )}
      <span class="hero-progress">
        <span class="hero-progress-label">ПРОГРЕС</span>
        <span class="bar hero-bar"><span id="total-fill" style="width:0%"></span></span>
        <span class="hero-progress-num" id="total-num">0/{TOPICS.length}</span>
      </span>
    </div>
  </section>

  {modules.map((m) => (
    <section class="module">
      <h2>{m.title}</h2>
      <div class="cards">
        {TOPICS.filter((t) => t.module === m.n).map((t) => {
          const lecture = bySlugPrefix.get(t.id);
          return lecture ? (
            <a
              class="card press"
              href={`/lektsiyi/${lecture.id}/`}
              data-slug={lecture.id}
              data-topic={t.id}
              data-slides={slideCount(lecture.body)}
            >
              <span class="lvl" data-lvl>LVL {t.id} · START</span>
              <span class="title">{t.short}</span>
              <span class="bar card-bar"><span data-fill style="width:0%"></span></span>
              <span class="meta" data-best></span>
            </a>
          ) : (
            <div class="card locked">
              <span class="lvl">LVL {t.id} · LOCKED</span>
              <span class="title">{t.short}</span>
              <span class="bar card-bar"></span>
              <span class="meta">незабаром</span>
            </div>
          );
        })}
      </div>
    </section>
  ))}

  <script>
    import { LEVELS } from '../lib/levels';

    let cleared = 0;
    /* Arrays rather than two "first match" variables: TypeScript cannot see an assignment
       made inside the forEach below and would narrow a nullable variable to null. */
    const started: { card: HTMLAnchorElement; slide: number }[] = [];
    const unread: HTMLAnchorElement[] = [];
    document.querySelectorAll<HTMLAnchorElement>('a.card').forEach((card) => {
      const { slug, topic, slides } = card.dataset;
      const total = Number(slides) || 1;
      let progress = 0;
      let read = false;
      let bests = 0;
      try {
        progress = Number(localStorage.getItem(`aiti:progress:${slug}`) ?? 0);
        read = localStorage.getItem(`aiti:read:${slug}`) === '1';
        bests = LEVELS.filter((l) => localStorage.getItem(`aiti:quiz:${topic}:${l.id}`)).length;
      } catch {
        // storage unavailable — cards fall back to their initial "START" state
      }

      const pct = read ? 100 : Math.min(100, Math.round((progress / total) * 100));
      const fill = card.querySelector<HTMLElement>('[data-fill]');
      const lvl = card.querySelector<HTMLElement>('[data-lvl]');
      const best = card.querySelector<HTMLElement>('[data-best]');

      if (fill) fill.style.width = `${pct}%`;
      if (read) {
        cleared++;
        card.dataset.state = 'cleared';
        if (lvl) lvl.textContent = `LVL ${topic} · CLEARED`;
      } else if (pct > 0) {
        card.dataset.state = 'progress';
        if (lvl) lvl.textContent = `LVL ${topic} · IN PROGRESS ${pct}%`;
      }
      /* Same wording as the level cards on /tests/, and "2" alone would read as a number of questions. */
      if (best && bests > 0) best.textContent = `тести складено: ${bests} з ${LEVELS.length}`;

      /* Where to send the hero button. A lecture in progress wins over an untouched one,
         and the first of each in curriculum order wins over later ones — there is no
         "last opened" timestamp in storage, so order is the only stable tie-breaker. */
      if (!read && pct > 0) started.push({ card, slide: progress });
      if (!read) unread.push(card);
    });

    const startBtn = document.getElementById('hero-start') as HTMLAnchorElement | null;
    const startLabel = document.getElementById('hero-start-label');
    const resumeAt = started[0];
    const nextUp = unread[0];
    if (startBtn && startLabel) {
      if (resumeAt) {
        startBtn.href = `${resumeAt.card.href}#slide-${resumeAt.slide}`;
        startLabel.textContent = `ПРОДОВЖИТИ · LVL ${resumeAt.card.dataset.topic}`;
      } else if (nextUp) {
        startBtn.href = nextUp.href;
        /* Nothing started yet keeps the arcade wording; a reader mid-course gets a next step. */
        if (cleared > 0) startLabel.textContent = `ДАЛІ · LVL ${nextUp.dataset.topic}`;
      } else {
        startBtn.href = '/tests/';
        /* The 8/8 counter beside the button already says everything is read. */
        startLabel.textContent = 'ДО ТЕСТІВ';
      }
    }

    const cards = document.querySelectorAll('.card').length;
    const totalFill = document.getElementById('total-fill');
    const totalNum = document.getElementById('total-num');
    if (totalFill && cards > 0) totalFill.style.width = `${Math.round((cleared / cards) * 100)}%`;
    if (totalNum) totalNum.textContent = `${cleared}/${cards}`;
  </script>

  <style>
    /* ---------- Hero ---------- */
    .hero { padding-block: 4.75rem 3.25rem; text-align: center; }
    .hero h1 {
      margin: 0 auto 1.375rem;
      font-size: clamp(20px, 3.4vw, 36px);
      line-height: 1.5;
      color: var(--text);
      text-shadow: 4px 4px 0 var(--title-shadow);
      max-width: 24ch;
    }
    .hero-lead {
      margin: 0 auto 1.875rem;
      font-size: 1.125rem;
      line-height: 1.65;
      max-width: 52ch;
      color: var(--text-soft);
    }
    .hero-actions {
      display: flex;
      gap: 1.125rem;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
    }
    .hero-progress {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-display);
      font-size: 10px;
    }
    .hero-progress-label { color: var(--muted); }
    .hero-progress-num { color: var(--accent); font-variant-numeric: tabular-nums; }
    .hero-bar { width: 110px; }

    /* ---------- Module sections ---------- */
    .module { margin-block: 3rem; }
    .module h2 {
      margin: 0 0 1.25rem;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.8;
      color: var(--accent);
    }

    .cards { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(15.625rem, 1fr)); }
    .card {
      display: grid;
      gap: 0.625rem;
      align-content: start;
      padding: 1.25rem;
      background: var(--surface);
      border: var(--bw) solid var(--ink);
      box-shadow: var(--shadow-hard-lg);
      text-decoration: none;
      color: var(--text);
    }
    .card.locked {
      background: var(--surface-3);
      border: var(--bw) dashed var(--muted-border);
      box-shadow: none;
      color: var(--muted);
    }
    .card .lvl {
      font-family: var(--font-display);
      font-size: 9px;
      line-height: 1.6;
      color: var(--accent);
    }
    .card.locked .lvl { color: var(--muted); }
    .card[data-state='cleared'] .lvl { color: var(--ok); }
    .card .title { font-weight: 600; font-size: 1.0625rem; line-height: 1.35; }
    .card-bar { height: 12px; }
    .card.locked .card-bar { border-color: var(--muted-border); }
    .card[data-state='cleared'] .card-bar > span { background: var(--ok); }
    .card .meta { font-size: 0.8125rem; line-height: 1.5; color: var(--muted); }
    .card .meta:empty { display: none; }

    @media (max-width: 40rem) {
      .hero { padding-block: 3rem 2.25rem; }
    }
  </style>
</Base>
