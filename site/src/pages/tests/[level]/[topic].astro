---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/quiz/Quiz.tsx';
import { groupBanks } from '../../../lib/banks';
import { levelById } from '../../../lib/levels';
import { QUIZ_RUN_SIZE } from '../../../lib/quiz';
import { topicById } from '../../../lib/topics';

/* One route per bank, not per file: a quiz is spread over several content files. */
export async function getStaticPaths() {
  return groupBanks(await getCollection('quizzes')).map((b) => ({
    params: { level: b.level, topic: b.topic },
    props: { topicId: b.topic, level: b.level, bankSize: b.questions.length },
  }));
}

const { topicId, level, bankSize } = Astro.props;
const topic = topicById(topicId);
const info = levelById(level)!;
/* The questions themselves arrive from bank.json; the page only needs the count. */
const runSize = Math.min(QUIZ_RUN_SIZE, bankSize);
---
<Base title={`Тест: ${topic?.short ?? topicId} (${info.word})`}>
  <header class="page-head">
    <p class="topic-label"><span class="g">★</span> BOSS FIGHT · {info.label} · {runSize} ПИТАНЬ <span class="g">★</span></p>
    <h1>{(topic?.short ?? 'Тема ' + topicId).toUpperCase()}</h1>
  </header>
  <Quiz client:load topic={topicId} level={level} bankUrl={`/tests/${level}/${topicId}/bank.json`} bankSize={bankSize} />
  <style>
    /* Kept short: on a laptop every pixel here is a pixel the run does not get. */
    .page-head { padding-block: 1.75rem 1.25rem; }
    .topic-label {
      margin: 0 0 0.75rem;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.8;
      color: var(--ok);
    }
    .page-head h1 {
      margin: 0;
      font-size: clamp(15px, 2.2vw, 22px);
      line-height: 1.5;
      text-shadow: 4px 4px 0 var(--title-shadow);
    }
  </style>
</Base>
