---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/quiz/Quiz.tsx';
import { topicById } from '../../../lib/topics';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes');
  return quizzes.map((q) => ({
    params: { topic: q.data.topic, level: q.data.level },
    props: { quiz: q },
  }));
}

const { quiz } = Astro.props;
const topic = topicById(quiz.data.topic);
const levelName = quiz.data.level === 'nurse' ? 'медсестра' : 'лікар';
---
<Base title={`Тест: ${topic?.short ?? quiz.data.topic} (${levelName})`}>
  <header class="page-head">
    <p class="topic-label"><span class="g">★</span> BOSS FIGHT · {levelName.toUpperCase()} · {quiz.data.questions.length} ПИТАНЬ <span class="g">★</span></p>
    <h1>{(topic?.short ?? 'Тема ' + quiz.data.topic).toUpperCase()}</h1>
  </header>
  <Quiz client:load topic={quiz.data.topic} level={quiz.data.level} questions={quiz.data.questions} />
  <style>
    .page-head { padding-block: 3.25rem 2rem; }
    .topic-label {
      margin: 0 0 1.125rem;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.8;
      color: var(--ok);
    }
    .page-head h1 {
      margin: 0;
      font-size: clamp(17px, 2.8vw, 28px);
      line-height: 1.5;
      text-shadow: 4px 4px 0 var(--title-shadow);
    }
  </style>
</Base>
