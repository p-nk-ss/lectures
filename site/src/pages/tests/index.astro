---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { groupBanks, type Bank } from '../../lib/banks';
import { QUIZ_RUN_SIZE } from '../../lib/quiz';
import { topicById } from '../../lib/topics';

const banks = groupBanks(await getCollection('quizzes'));
const byTopic = new Map<string, Bank[]>();
for (const b of banks) byTopic.set(b.topic, [...(byTopic.get(b.topic) ?? []), b]);
const topics = [...byTopic.keys()];
---
<Base title="Тести — АіІТ">
  <header class="page-head">
    <p class="kicker"><span class="g">★</span> BOSS FIGHTS <span class="g">★</span></p>
    <h1>ТЕСТИ ДЛЯ САМОКОНТРОЛЮ</h1>
    <p class="lead">Найкращий результат зберігається у вашому браузері.</p>
  </header>
  {topics.map((id) => {
    const t = topicById(id);
    return (
      <section class="topic-tests">
        <h2>LVL {id} · {(t?.short ?? `ТЕМА ${id}`).toUpperCase()}</h2>
        <div class="levels">
          {(byTopic.get(id) ?? []).map((b) => (
            <a class="level-card press" href={`/tests/${id}/${b.level}/`} data-topic={id} data-level={b.level}>
              <span class="level-name">
                <span class="g">{b.level === 'nurse' ? '♥' : '✚'}</span>{' '}
                {b.level === 'nurse' ? 'МЕДСЕСТРА' : 'ЛІКАР'}
              </span>
              <span class="count">
                {Math.min(QUIZ_RUN_SIZE, b.questions.length)} питань
                {b.questions.length > QUIZ_RUN_SIZE && ` з банку на ${b.questions.length}`}
              </span>
              <span class="best" data-best></span>
            </a>
          ))}
        </div>
      </section>
    );
  })}
  <script>
    document.querySelectorAll<HTMLAnchorElement>('.level-card').forEach((card) => {
      const raw = localStorage.getItem(`aiti:quiz:${card.dataset.topic}:${card.dataset.level}`);
      if (!raw) return;
      try {
        const b = JSON.parse(raw);
        card.querySelector('[data-best]')!.textContent = `найкраще: ${b.score}/${b.total}`;
      } catch {}
    });
  </script>
  <style>
    .page-head { padding-block: 3.25rem 1.5rem; }
    .page-head h1 {
      margin: 0 0 0.875rem;
      font-size: clamp(18px, 3vw, 30px);
      line-height: 1.5;
      text-shadow: 4px 4px 0 var(--title-shadow);
    }
    .lead { color: var(--text-soft); margin: 0; }

    .topic-tests { margin-block: 2.25rem; }
    .topic-tests h2 {
      margin: 0 0 1rem;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.8;
      color: var(--accent);
    }
    .levels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
    .level-card {
      display: grid;
      gap: 0.5rem;
      align-content: start;
      background: var(--surface);
      border: var(--bw) solid var(--ink);
      box-shadow: var(--shadow-hard-lg);
      padding: 1.25rem;
      text-decoration: none;
      color: var(--text);
    }
    .level-name {
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.7;
      color: var(--ok);
    }
    .level-name :global(.g) { font-size: 0.875rem; }
    .best, .count { color: var(--muted); font-size: 0.8125rem; }
    .best:empty { display: none; }
  </style>
</Base>
