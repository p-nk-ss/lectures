---
/**
 * Level choice.
 *
 * The reader belongs to one track and would otherwise ignore half of sixteen cards on
 * every visit. Choosing the level first also makes the address read in the same order as
 * the navigation: /tests/ → /tests/nurse/ → /tests/nurse/03/.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { groupBanks } from '../../lib/banks';
import { LEVELS } from '../../lib/levels';
import { QUIZ_RUN_SIZE } from '../../lib/quiz';
import { topicById } from '../../lib/topics';

/* 99 is a fixture: it has a bank but no topic in the registry, and must not be listed. */
const banks = groupBanks(await getCollection('quizzes')).filter((b) => topicById(b.topic));
const countFor = (level: string) => banks.filter((b) => b.level === level).length;
---
<Base title="Тести — АіІТ">
  <header class="page-head">
    <p class="kicker"><span class="g">★</span> BOSS FIGHTS <span class="g">★</span></p>
    <h1>ТЕСТИ ДЛЯ САМОКОНТРОЛЮ</h1>
    <p class="lead">Оберіть рівень — далі відкриється список тем. Найкращий результат зберігається у вашому браузері.</p>
  </header>

  <div class="levels">
    {LEVELS.map((l) => (
      <a class="level-pick press" href={`/tests/${l.id}/`} data-level={l.id}>
        <span class="pick-name"><span class="g">{l.glyph}</span> {l.label}</span>
        <span class="pick-blurb">{l.blurb}</span>
        <span class="pick-meta">
          {countFor(l.id)} тем · по {QUIZ_RUN_SIZE} питань у прогоні
          <span class="pick-done" data-done></span>
        </span>
      </a>
    ))}
  </div>

  <script>
    import { LEVELS } from '../../lib/levels';
    import { getBest } from '../../lib/storage';
    import { TOPICS } from '../../lib/topics';

    /* How many topics this level already has a saved result for. Read on load, like the
       home cards: nothing is stored server-side. */
    for (const l of LEVELS) {
      const card = document.querySelector<HTMLElement>(`.level-pick[data-level="${l.id}"] [data-done]`);
      if (!card) continue;
      const done = TOPICS.filter((t) => getBest(t.id, l.id)).length;
      if (done) card.textContent = ` · складено ${done} з ${TOPICS.length}`;
    }
  </script>

  <style>
    .page-head { padding-block: 3.25rem 1.5rem; }
    .page-head h1 {
      margin: 0 0 0.875rem;
      font-size: clamp(18px, 3vw, 30px);
      line-height: 1.5;
      text-shadow: 4px 4px 0 var(--title-shadow);
    }
    .lead { color: var(--text-soft); margin: 0; max-width: 46rem; }

    .levels {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      margin-block: 1rem 3rem;
    }
    .level-pick {
      display: grid;
      gap: 0.875rem;
      align-content: start;
      background: var(--surface);
      border: var(--bw) solid var(--ink);
      box-shadow: var(--shadow-hard-xl);
      padding: 2rem 1.75rem;
      text-decoration: none;
      color: var(--text);
    }
    .pick-name {
      font-family: var(--font-display);
      font-size: 14px;
      line-height: 1.7;
      color: var(--ok);
    }
    .pick-name :global(.g) { font-size: 1.125rem; }
    .pick-blurb { color: var(--text-soft); line-height: 1.6; }
    .pick-meta { color: var(--muted); font-size: 0.8125rem; }
  </style>
</Base>
