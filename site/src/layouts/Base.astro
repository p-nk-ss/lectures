---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';
import Dock from '../components/Dock.astro';

interface Props { title: string; description?: string }
const { title, description = 'Лекції з анестезіології та інтенсивної терапії' } = Astro.props;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script is:inline>
      // Dark is the default; light is an explicit stored choice.
      if (localStorage.getItem('aiti:theme') === 'light')
        document.documentElement.dataset.theme = 'light';
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">АіІТ<span class="brand-dot">·</span>лекції</a>
      </div>
    </header>
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <p>Навчальні матеріали. Не замінюють клінічні протоколи та призначення лікаря.</p>
      </div>
    </footer>
    <Dock />
    <SearchModal />
    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 72%, transparent);
        backdrop-filter: blur(14px) saturate(160%);
        -webkit-backdrop-filter: blur(14px) saturate(160%);
        border-bottom: 1px solid var(--border);
      }
      .site-header .container { display: flex; align-items: center; height: 52px; }
      .brand {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--text);
      }
      .brand-dot { color: var(--primary); margin-inline: 0.2rem; }
      .site-footer {
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.85rem;
        padding-block: 1.5rem;
        margin-top: 4rem;
      }
      .site-footer p { margin: 0; }
    </style>
  </body>
</html>
