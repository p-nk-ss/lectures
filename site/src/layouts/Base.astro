---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';
import SettingsModal from '../components/SettingsModal.astro';

interface Props {
  title: string;
  description?: string;
  /* 'presentation' drops the chrome so the page can own the full viewport (lecture slides). */
  variant?: 'default' | 'presentation';
}
const {
  title,
  description = 'Лекції з анестезіології та інтенсивної терапії',
  variant = 'default',
} = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const nav = [
  { href: '/', label: 'Лекції' },
  { href: '/tests/', label: 'Тести' },
  { href: '/glossary/', label: 'Глосарій' },
  { href: '/video/', label: 'Відео' },
];
---
<!doctype html>
<html lang="uk" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </head>
  <body>
    {variant === 'default' && (
      <header class="site-header">
        <div class="header-row">
          <a href="/" class="brand">АІТ<span class="brand-dot">·</span>ЛЕКЦІЇ</a>
          <nav class="nav" aria-label="Головна навігація">
            {nav.map((item) => (
              <a
                class:list={['nav-item', { on: isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >{item.label}</a>
            ))}
            <button class="nav-item search" id="search-open" aria-label="Пошук (Ctrl+K)">⌕</button>
            <button class="nav-item search" id="settings-open" aria-label="Прогрес і скидання">⚙</button>
          </nav>
        </div>
      </header>
    )}
    {variant === 'default'
      ? <main class="container"><slot /></main>
      : <slot />}
    {variant === 'default' && (
      <footer class="site-footer">
        <div class="container">
          <p>Навчальні матеріали. Не замінюють клінічні протоколи та призначення лікаря.</p>
        </div>
      </footer>
    )}
    <SearchModal />
    <SettingsModal />
    <style>
      .site-header {
        background: var(--surface);
        border-bottom: var(--bw) solid var(--ink);
      }
      .header-row {
        max-width: 66rem;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
      }
      .brand {
        font-family: var(--font-display);
        font-size: 12px;
        line-height: 1.6;
        color: var(--accent);
        text-shadow: 2px 2px 0 var(--ink);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand:hover { color: var(--accent); }
      .brand-dot { color: var(--ok); }

      .nav { display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; }
      .nav-item {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.875rem;
        line-height: 1.4;
        text-decoration: none;
        color: var(--text);
        background: transparent;
        padding: 0.5rem 1rem;
        border: var(--bw-sm) solid transparent;
        cursor: pointer;
      }
      .nav-item:hover, .nav-item:focus-visible { color: var(--text); border-color: var(--accent); outline: none; }
      .nav-item.on {
        color: var(--ink);
        background: var(--accent);
        border-color: var(--ink);
        box-shadow: 3px 3px 0 var(--ink);
      }
      .nav-item.search { color: var(--muted); font-size: 1.25rem; padding: 0.25rem 0.75rem; }
      .nav-item.search:hover { color: var(--accent); }

      .site-footer {
        border-top: var(--bw) solid var(--ink);
        background: var(--surface-2);
        color: var(--muted);
        font-size: 0.875rem;
        padding-block: 1.75rem;
        margin-top: 5rem;
      }
      .site-footer p { margin: 0; }

      @media (max-width: 40rem) {
        .header-row { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
        .nav { gap: 0.375rem; }
        .nav-item { padding: 0.4rem 0.7rem; font-size: 0.8125rem; }
      }
    </style>
  </body>
</html>
