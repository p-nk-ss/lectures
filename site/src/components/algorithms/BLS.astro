{/* BLS chain per ERC 2021 / RCUK 2025. Colors follow site CSS variables.
    Intrinsic width/height keep it at 1:1 — without them the SVG stretches to the
    container and scales every stroke and label with it. Box width fits the longest
    caption in IBM Plex Mono (~42 chars at 12.5px ≈ 315px). */}
<svg width="480" height="640" viewBox="0 0 480 640" role="img" aria-label="Алгоритм базової підтримки життя (BLS)">
  <defs>
    {/* Arrow drawn on a 4px pixel grid (same unit as the 4px borders) — a smooth
        triangular marker read as anti-aliased vector against the flat pixel style. */}
    <symbol id="bls-arrow" viewBox="0 0 20 24">
      <rect x="8" y="0" width="4" height="8" />
      <rect x="0" y="8" width="20" height="4" />
      <rect x="2" y="12" width="16" height="4" />
      <rect x="6" y="16" width="8" height="4" />
      <rect x="8" y="20" width="4" height="4" />
    </symbol>
  </defs>
  <style>
    .box { fill: var(--surface); stroke: var(--ink); stroke-width: 4; }
    .box-danger { fill: var(--danger-bg); stroke: var(--danger); }
    .box-ok { fill: var(--surface); stroke: var(--ok); }
    .t { font: 600 15px var(--font-body, monospace); fill: var(--text); text-anchor: middle; }
    .t-small { font: 400 12.5px var(--font-body, monospace); fill: var(--text-soft); text-anchor: middle; }

    /* Each arrow lights up in turn, top to bottom, tracing the flow of the algorithm.
       steps(1, end) snaps between states — no fades, matching the pixel style.
       `backwards` holds the dim first frame during the stagger delay, so arrows below
       the current one stay dim instead of flashing bright before their turn. */
    .arrow {
      fill: var(--accent);
      opacity: 0.35;
      animation: bls-flow 2.4s steps(1, end) infinite backwards;
      animation-delay: calc(var(--i) * 0.3s);
    }
    @keyframes bls-flow {
      0%, 100% { opacity: 0.35; }
      5% { opacity: 1; }
      17% { opacity: 0.35; }
    }
    /* Motion off: every arrow simply stays fully visible. */
    @media (prefers-reduced-motion: reduce) {
      .arrow { opacity: 1; animation: none; }
    }
  </style>

  <rect class="box" x="30" y="10" width="420" height="58" />
  <text class="t" x="240" y="34">Не реагує?</text>
  <text class="t-small" x="240" y="54">Безпека місця, обережно струснути, гукнути</text>
  <use class="arrow" href="#bls-arrow" x="230" y="69" width="20" height="24" style="--i:0" />

  <rect class="box box-danger" x="30" y="96" width="420" height="58" />
  <text class="t" x="240" y="120">Викликати 112</text>
  <text class="t-small" x="240" y="140">Негайно; гучний звʼязок, слухати диспетчера</text>
  <use class="arrow" href="#bls-arrow" x="230" y="155" width="20" height="24" style="--i:1" />

  <rect class="box" x="30" y="182" width="420" height="58" />
  <text class="t" x="240" y="206">Дихання відсутнє / ненормальне?</text>
  <text class="t-small" x="240" y="226">Відкрити дихальні шляхи; ґаспінґ = зупинка</text>
  <use class="arrow" href="#bls-arrow" x="230" y="241" width="20" height="24" style="--i:2" />

  <rect class="box box-danger" x="30" y="268" width="420" height="74" />
  <text class="t" x="240" y="292">30 компресій : 2 вдихи</text>
  <text class="t-small" x="240" y="312">100–120/хв · 5–6 см · повний відскок</text>
  <text class="t-small" x="240" y="330">мінімальні паузи, зміна виконавця ~2 хв</text>
  <use class="arrow" href="#bls-arrow" x="230" y="343" width="20" height="24" style="--i:3" />

  <rect class="box" x="30" y="370" width="420" height="58" />
  <text class="t" x="240" y="394">АЗД — якнайшвидше</text>
  <text class="t-small" x="240" y="414">Увімкнути та виконувати голосові підказки</text>
  <use class="arrow" href="#bls-arrow" x="230" y="429" width="20" height="24" style="--i:4" />

  <rect class="box" x="30" y="456" width="420" height="74" />
  <text class="t" x="240" y="480">Ритм шоковий?</text>
  <text class="t-small" x="240" y="500">Так → 1 розряд → одразу СЛР 2 хв</text>
  <text class="t-small" x="240" y="518">Ні → СЛР 2 хв → повторний аналіз</text>
  <use class="arrow" href="#bls-arrow" x="230" y="531" width="20" height="24" style="--i:5" />

  <rect class="box box-ok" x="30" y="558" width="420" height="72" />
  <text class="t" x="240" y="582">Продовжувати</text>
  <text class="t-small" x="240" y="602">до прибуття ЕМД, ознак ROSC</text>
  <text class="t-small" x="240" y="620">або виснаження рятувальника</text>
</svg>
