---
// Danger card: red border on the alert background, pixel "!! ВАЖЛИВО" label.
---
<aside class="callout important" role="note">
  <p class="label">!! ВАЖЛИВО</p>
  <div class="body"><slot /></div>
</aside>
<style>
  .important {
    background: var(--danger-bg);
    border: var(--bw) solid var(--danger);
    box-shadow: var(--shadow-hard-lg);
    padding: 1.625rem;
    margin-block: 1.5rem;
  }
  .label {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 10px;
    line-height: 1.6;
    color: var(--danger);
  }
  .body :global(> :first-child) { margin-top: 0; }
  .body :global(> :last-child) { margin-bottom: 0; }
  .body :global(p), .body :global(li) { color: var(--danger-text); }
  .body :global(strong) { color: #fff; }
</style>
