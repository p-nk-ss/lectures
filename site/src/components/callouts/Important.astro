---
import Icon from '../Icon.astro';
---
<aside class="callout important" role="note">
  <strong class="label"><Icon name="alert-triangle" size={17} /> Важливо</strong>
  <div><slot /></div>
</aside>
<style>
  .callout { border-radius: var(--radius); padding: 1rem 1.15rem; margin-block: 1.1rem; border: 1px solid; }
  .important { background: color-mix(in srgb, var(--danger) 9%, var(--surface)); border-color: color-mix(in srgb, var(--danger) 35%, transparent); }
  .label { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.35rem; color: var(--danger); font-family: var(--font-heading); }
</style>
