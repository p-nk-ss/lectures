---
// Clinical vignette: green-bordered panel with a "SIDE QUEST" pixel label.
interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="callout case" role="note">
  <p class="label"><span class="g">◆</span> КЕЙС{title ? ` · ${title.toUpperCase()}` : ''}</p>
  <div class="body"><slot /></div>
</aside>
<style>
  .case {
    background: var(--surface);
    border: var(--bw) solid var(--ok);
    box-shadow: var(--shadow-hard-lg);
    padding: 1.625rem;
    margin-block: 1.5rem;
  }
  .label {
    margin: 0 0 0.875rem;
    font-family: var(--font-display);
    font-size: 10px;
    line-height: 1.7;
    color: var(--ok);
  }
  .body :global(> :first-child) { margin-top: 0; }
  .body :global(> :last-child) { margin-bottom: 0; }
  .body :global(p), .body :global(li) { color: var(--text-body); }
</style>
