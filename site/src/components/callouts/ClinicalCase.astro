---
import Icon from '../Icon.astro';

interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="callout case" role="note">
  <strong class="label"><Icon name="stethoscope" size={17} /> Клінічний випадок{title ? `: ${title}` : ''}</strong>
  <div><slot /></div>
</aside>
<style>
  .callout { border-radius: var(--radius); padding: 1rem 1.15rem; margin-block: 1.1rem; border: 1px solid; }
  .case { background: color-mix(in srgb, var(--primary) 9%, var(--surface)); border-color: color-mix(in srgb, var(--primary) 35%, transparent); }
  .label { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.35rem; color: var(--primary); font-family: var(--font-heading); }
</style>
