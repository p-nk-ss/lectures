---
// Optional deep-dive block: green-bordered panel with a pixel "+ / −" affordance.
---
<details class="for-doctors">
  <summary><span class="g">▸</span> ДОДАТКОВО</summary>
  <div class="body"><slot /></div>
</details>
<style>
  .for-doctors {
    background: var(--surface);
    border: var(--bw) solid var(--ok);
    box-shadow: var(--shadow-hard-lg);
    margin-block: 1.5rem;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 10px;
    line-height: 1.6;
    padding: 1.125rem 1.375rem;
    color: var(--ok);
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: auto; font-size: 14px; line-height: 1; }
  details[open] summary::after { content: '−'; }
  .body { padding: 0 1.375rem 1.375rem; }
  .body :global(> :first-child) { margin-top: 0; }
  .body :global(> :last-child) { margin-bottom: 0; }
  .body :global(p), .body :global(li) { color: var(--text-body); }
</style>
