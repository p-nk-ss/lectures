---
// Lite embed: a compact preview card that opens the player in a shared lightbox.
// Nothing from YouTube is requested until the viewer clicks (only the thumbnail loads).
// `description` is not rendered on the lecture page — the card stays compact. It is read
// off the MDX source by src/lib/videos.ts to caption the entry in the video library.
interface Props { id: string; title: string; description?: string }
const { id, title } = Astro.props;
---
<button class="yt" data-id={id} data-title={title} aria-label={`Відтворити відео: ${title}`}>
  <span class="yt-thumb">
    {/* mqdefault is a true 16:9 crop; hqdefault would come letterboxed with black bars. */}
    <img src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />
    <span class="yt-play" aria-hidden="true">▶</span>
  </span>
  <span class="yt-title">{title}</span>
</button>
<script>
  // One lightbox for every embed on the page, built on first use.
  let dialog: HTMLDialogElement | null = null;

  function build(): HTMLDialogElement {
    const el = document.createElement('dialog');
    el.className = 'yt-lightbox';
    el.innerHTML =
      '<div class="yt-bar"><span class="yt-bar-title"></span>' +
      '<button class="yt-close" aria-label="Закрити">✕</button></div>' +
      '<div class="yt-stage"></div>';
    el.querySelector('.yt-close')!.addEventListener('click', () => el.close());
    el.addEventListener('click', (e) => { if (e.target === el) el.close(); });
    // Covers the close button, Esc and the backdrop alike: dropping the iframe is what
    // actually stops playback — a hidden dialog would keep the audio running.
    el.addEventListener('close', () => { el.querySelector('.yt-stage')!.innerHTML = ''; });
    document.body.append(el);
    return el;
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('button.yt')) {
    btn.addEventListener('click', () => {
      dialog ??= build();
      const { id, title } = btn.dataset;
      dialog.querySelector('.yt-bar-title')!.textContent = title ?? '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = title ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      const stage = dialog.querySelector('.yt-stage')!;
      stage.replaceChildren(iframe);
      dialog.showModal();
    });
  }
</script>
<style>
  .yt {
    display: grid;
    gap: 0;
    width: 100%;
    max-width: 24rem;
    padding: 0;
    cursor: pointer;
    text-align: left;
    background: var(--surface);
    border: var(--bw) solid var(--ink);
    box-shadow: var(--shadow-hard);
    color: var(--text);
    margin-block: 1.5rem;
  }
  .yt:hover, .yt:focus-visible {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--ink);
    border-color: var(--accent);
  }
  .yt-thumb { position: relative; display: block; }
  .yt-thumb img { display: block; width: 100%; height: auto; }
  .yt-play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--ink);
    background: var(--accent);
    border: var(--bw) solid var(--ink);
  }
  .yt-title {
    padding: 0.75rem 0.875rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-soft);
    border-top: var(--bw-sm) solid var(--ink);
  }
</style>
