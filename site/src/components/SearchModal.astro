---
import Icon from './Icon.astro';
---
<dialog id="search-dialog">
  <button id="search-close" aria-label="Закрити"><Icon name="x" size={16} /></button>
  <div id="search"></div>
  <p id="search-fallback" hidden>Пошук доступний лише у зібраній версії сайту.</p>
</dialog>
<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  let inited = false;

  async function openSearch() {
    dialog.showModal();
    if (inited) return;
    inited = true;
    try {
      // Served from /pagefind/ in the built site; absent in dev.
      // pagefind-ui.js is UMD: it attaches PagefindUI to window, module namespace is empty.
      await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js' as string);
      const PagefindUI = (window as any).PagefindUI;
      if (!PagefindUI) throw new Error('PagefindUI not loaded');
      new PagefindUI({ element: '#search', showSubResults: true, translations: { placeholder: 'Пошук по лекціях…' } });
    } catch {
      document.getElementById('search-fallback')!.hidden = false;
    }
  }

  document.getElementById('search-open')?.addEventListener('click', openSearch);
  document.getElementById('search-close')?.addEventListener('click', () => dialog.close());
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : openSearch();
    }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
<style>
  dialog {
    width: min(40rem, 92vw);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    padding: 1.25rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }
  dialog::backdrop {
    background: rgba(5, 6, 12, 0.6);
    backdrop-filter: blur(4px);
  }
  #search-close {
    float: right;
    display: inline-flex;
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem;
    cursor: pointer;
    color: var(--text-muted);
  }
  #search-close:hover { color: var(--text); border-color: var(--border-strong); }
  /* Pagefind UI theme alignment */
  #search { --pagefind-ui-primary: var(--primary); --pagefind-ui-text: var(--text); --pagefind-ui-background: var(--surface); --pagefind-ui-border: var(--border); --pagefind-ui-tag: var(--surface-2); --pagefind-ui-border-radius: var(--radius-sm); --pagefind-ui-font: var(--font-body); }
</style>
