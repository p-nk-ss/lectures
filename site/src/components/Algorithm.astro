---
interface Props { title: string }
const { title } = Astro.props;
---
<figure class="algorithm">
  <div class="scroll"><slot /></div>
  <figcaption>{title}</figcaption>
</figure>
<style>
  /* Frame hugs the diagram instead of stretching it across the slide. */
  .algorithm { margin: 1.5rem auto; width: fit-content; max-width: 100%; }
  .scroll {
    overflow-x: auto;
    background: var(--surface-3);
    border: var(--bw) solid var(--ink);
    box-shadow: var(--shadow-hard);
    padding: 1.25rem;
  }
  /* Respect the SVG's intrinsic size; only shrink it when the frame is narrower. */
  .scroll :global(svg) { display: block; margin-inline: auto; max-width: 100%; height: auto; }
  figcaption {
    text-align: center;
    font-family: var(--font-display);
    font-size: 9px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 0.75rem;
    text-transform: uppercase;
  }
</style>
